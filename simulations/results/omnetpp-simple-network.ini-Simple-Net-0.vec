config image-path ../../inet4.5/images
config **.contentServer1.numApps 1
config **.contentServer1.app[0].typename ContentHostApp
config **.contentServer1.app[0].hostedPrefixNames "\"ccnx://spacetime.com/\""
config **.contentServer1.app[0].dataNamePrefix "\"sptm\""
config **.contentServer1.app[0].segmentSize 1000byte
config **.contentServer1.app[0].numSegmentsPerFile "intuniform(5, 20)"
config **.contentServer1.app[0].cacheTime 2h
config **.contentServer2.numApps 1
config **.contentServer2.app[0].typename ContentHostApp
config **.contentServer2.app[0].hostedPrefixNames "\"ccnx://relativity.com/\""
config **.contentServer2.app[0].dataNamePrefix "\"rltv\""
