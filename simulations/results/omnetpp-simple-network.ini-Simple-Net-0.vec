config **.wirelessNode[*].app[0].typename ContentDownloadApp
config **.wirelessNode[*].app[0].interContentDownloadInterval "uniform(100.0s, 150.0s)"
config **.wirelessNode[*].app[0].requestedPrefixNames "\"ccnx://spacetime.com/\""
config **.wirelessNode[*].app[0].dataNamePrefix "\"sptm\""
