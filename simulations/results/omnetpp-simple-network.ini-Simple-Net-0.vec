config **.wirelessNode[*].app[0].nextFileSuffix "intuniform(0, 99)"
config **.wirelessNode[*].btWirelessRange 30m
config **.wirelessNode[*].wlanWirelessRange 100m
config **.wirelessNode[*].**.constraintAreaMinX 50m
config **.wirelessNode[*].**.constraintAreaMinY 50m
config **.wirelessNode[*].**.constraintAreaMinZ 0m
config **.wirelessNode[*].**.constraintAreaMaxX 150m
config **.wirelessNode[*].**.constraintAreaMaxY 150m
config **.wirelessNode[*].**.constraintAreaMaxZ 0m
config **.wirelessNode[*].mobility "\"RandomWaypointMobility\""
config **.wirelessNode[*].**.speed "uniform(1mps, 2mps)"
config **.wirelessNode[*].**.waitTime "uniform(1200s, 1800s)"
config **.wirelessAccessRouter.wlanWirelessRange 100m
config **.accessRouter.accessRouterNumWiredTransports 3
config **.wiredNode*.numApps 1
config **.wiredNode*.app[0].typename ContentDownloadApp
config **.wiredNode*.app[0].interContentDownloadInterval "uniform(100.0s, 150.0s)"
config **.wiredNode*.app[0].requestedPrefixNames "\"ccnx://relativity.com/\""
config **.wiredNode*.app[0].dataNamePrefix "\"rltv\""
config **.wiredNode*.app[0].interestRetransmitTimeout 120s
config **.wiredNode*.app[0].nextFileSuffix "intuniform(0, 9)"
config **.coreRouter1.coreRouterNumWiredTransports 4
config **.coreRouter2.coreRouterNumWiredTransports 2
config **.constraintAreaMinX 0m
config **.constraintAreaMinY 0m
config **.constraintAreaMinZ 0m
config **.constraintAreaMaxX 400m
config **.constraintAreaMaxY 400m
config **.constraintAreaMaxZ 0m
config **.updateInterval 1s
config **.initFromDisplayString true
config network SimpleNetwork
config sim-time-limit 48h
config repeat 1
config num-rngs 8
